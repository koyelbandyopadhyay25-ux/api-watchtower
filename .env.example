# Copy to apps/api/.env only if it does not exist. Choose your own local password.
# Replace the placeholder in all three values. URL-encode it inside URLs.
POSTGRES_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"
DATABASE_URL="postgresql://watchtower:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/watchtower_dev?schema=public"
PORT=3001
# Local management requires BOTH values. Leave disabled until the local DB is ready.
NODE_ENV=development
ENABLE_LOCAL_MANAGEMENT=false
# Local HTTP development exception ONLY: cookies are otherwise Secure by default.
# Keep Secure cookies for HTTPS. This does not enable public/production management.
AUTH_COOKIE_SECURE=false
# Separate process, separate opt-in. Never starts with npm run dev.
ENABLE_SCHEDULER_WORKER=false
# Separate opt-in, local Mailpit capture only. No external recipients/transports.
ENABLE_EMAIL_DISPATCHER=false
EMAIL_DELIVERY_MODE=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
# Set to true ONLY after confirming watchtower_dev is empty and disposable.
DEV_DATABASE_DISPOSABLE=false
# Optional: leave blank to skip PostgreSQL integration tests.
# Example: postgresql://watchtower:YOUR_ENCODED_PASSWORD@127.0.0.1:5433/watchtower_test?schema=public
TEST_DATABASE_URL=""
TEST_DATABASE_DISPOSABLE=false
