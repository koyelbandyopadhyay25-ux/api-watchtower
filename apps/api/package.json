{
  "name": "@watchtower/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --exclude \"./src/generated/**\" src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev:worker": "prisma generate && tsx src/worker/main.ts",
    "start:worker": "node dist/worker/main.js",
    "worker:once": "prisma generate && tsx src/worker/main.ts --once",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:db": "prisma generate && vitest run tests/database.integration.test.ts tests/scheduling.integration.test.ts tests/authentication.integration.test.ts tests/notifications.integration.test.ts tests/approved-targets.integration.test.ts",
    "test:mailpit": "vitest run tests/mailpit.integration.test.ts",
    "dev:email": "prisma generate && tsx src/notifications/main.ts",
    "start:email": "node dist/notifications/main.js",
    "email:once": "prisma generate && tsx src/notifications/main.ts --once",
    "db:notifications:plan": "tsx scripts/notification-plan.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/initialize-database.ts development",
    "db:prepare-test": "tsx scripts/initialize-database.ts test",
    "db:verify": "tsx src/database/verify-database.ts",
    "db:auth:plan": "tsx scripts/authentication-plan.ts",
    "db:auth:verify": "tsx scripts/verify-authentication-preservation.ts",
    "db:schedule:plan": "tsx scripts/scheduling-migration.ts plan",
    "db:schedule:apply": "tsx scripts/scheduling-migration.ts apply"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "argon2": "^0.45.1",
    "cookie": "^0.7.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prisma": "~7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
