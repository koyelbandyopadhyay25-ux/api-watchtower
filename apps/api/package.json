{
  "name": "@watchtower/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:db": "prisma generate && vitest run tests/database.integration.test.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/initialize-database.ts development",
    "db:prepare-test": "tsx scripts/initialize-database.ts test",
    "db:verify": "tsx src/database/verify-database.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prisma": "~7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
